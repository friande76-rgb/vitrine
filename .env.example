# Copia este ficheiro para ".env.local" e preenche.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# chave secreta (antiga "service_role"). NUNCA a partilhes.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Meshy → https://www.meshy.ai/settings/api
# Para testar SEM gastar créditos usa a chave de teste:
# msy_dummy_api_key_for_test_mode_12345678
MESHY_API_KEY=msy_dummy_api_key_for_test_mode_12345678

# Endereço público da app (é o que vai dentro dos QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
